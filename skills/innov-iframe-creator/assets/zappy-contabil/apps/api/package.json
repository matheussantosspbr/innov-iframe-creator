{
  "name": "api",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "prisma generate && node --watch --env-file-if-exists=.env src/server/server.ts",
    "start": "node src/server/server.ts",
    "test": "prisma generate && vitest run",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "openapi:schema": "node src/scripts/print-openapi.ts",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@axiomhq/pino": "^2.0.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "prisma": "^7.10.1",
    "zdk": "^1.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
