{
  "openapi": "3.0.3",
  "info": {
    "title": "iframe-name",
    "version": "1.0.0",
    "description": "Resposta de sucesso { body }, erro { error: { message } }. Rotas /api/tenants usam x-comhub-key; rotas /api/app usam x-tenant-id e x-user-id."
  },
  "components": {
    "securitySchemes": {
      "comhubKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-comhub-key",
        "description": "Chave de operação (APPLICATION_X_COMHUB_KEY)"
      },
      "tenantId": {
        "type": "apiKey",
        "in": "header",
        "name": "x-tenant-id",
        "description": "Id do tenant (id devolvido no cadastro)"
      },
      "userId": {
        "type": "apiKey",
        "in": "header",
        "name": "x-user-id",
        "description": "Id do usuário da Zappy que abriu o iframe"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/api/tenants/": {
      "post": {
        "summary": "Cadastra uma empresa (tenant)",
        "tags": ["tenants"],
        "description": "Valida a URL (https://api-<subdominio>.zapcontabil.chat) e prova o token na instância da Zappy antes de gravar. O token é cifrado em repouso e nunca é devolvido. Exige o header x-comhub-key.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "description": "Rótulo legível do cliente",
                    "example": "Escritório Exemplo"
                  },
                  "zappyUrl": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "example": "https://api-exemplo.zapcontabil.chat"
                  },
                  "zappyToken": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Token de API da instância da Zappy",
                    "example": "<token de API>"
                  }
                },
                "required": ["name", "zappyUrl", "zappyToken"]
              }
            }
          }
        },
        "security": [
          {
            "comhubKey": []
          }
        ],
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "body": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "example": "0b9e6d4e-5a35-4d6e-9f35-6b1c1f3c9a10"
                        },
                        "name": {
                          "type": "string",
                          "example": "Escritório Exemplo"
                        },
                        "zappyUrl": {
                          "type": "string",
                          "example": "https://api-exemplo.zapcontabil.chat"
                        },
                        "active": {
                          "type": "boolean"
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "updatedAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": ["id", "name", "zappyUrl", "active", "createdAt", "updatedAt"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["body"],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Chave de operação ausente ou inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": ["message"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["error"],
                  "additionalProperties": false,
                  "description": "Chave de operação ausente ou inválida.",
                  "example": {
                    "error": {
                      "message": "Chave de operação ausente ou inválida."
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Já existe uma empresa cadastrada com esta URL da Zappy.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": ["message"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["error"],
                  "additionalProperties": false,
                  "description": "Já existe uma empresa cadastrada com esta URL da Zappy.",
                  "example": {
                    "error": {
                      "message": "Já existe uma empresa cadastrada com esta URL da Zappy."
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "A Zappy recusou o token de API. Gere um novo token na instância e tente novamente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": ["message"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["error"],
                  "additionalProperties": false,
                  "description": "A Zappy recusou o token de API. Gere um novo token na instância e tente novamente.",
                  "example": {
                    "error": {
                      "message": "A Zappy recusou o token de API. Gere um novo token na instância e tente novamente."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Não foi possível validar o token agora porque a instância da Zappy não respondeu. Tente novamente em instantes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": ["message"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["error"],
                  "additionalProperties": false,
                  "description": "Não foi possível validar o token agora porque a instância da Zappy não respondeu. Tente novamente em instantes.",
                  "example": {
                    "error": {
                      "message": "Não foi possível validar o token agora porque a instância da Zappy não respondeu. Tente novamente em instantes."
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Lista as empresas cadastradas",
        "tags": ["tenants"],
        "description": "Não inclui o token. Exige o header x-comhub-key.",
        "security": [
          {
            "comhubKey": []
          }
        ],
        "responses": {
