    "/api/app/connections": {
      "get": {
        "summary": "Lista as conexões de WhatsApp da empresa",
        "tags": ["app"],
        "description": "Consulta a instância da Zappy da empresa. Exige x-tenant-id e x-user-id.",
        "security": [
          {
            "tenantId": [],
            "userId": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "body": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "number",
                            "example": 1
                          },
                          "name": {
                            "type": "string",
                            "example": "Comercial"
                          },
                          "status": {
                            "type": "string",
                            "example": "CONNECTED"
                          }
                        },
                        "required": ["id", "name", "status"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["body"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Não foi possível identificar a empresa e o usuário. Abra o app pela Zappy.",
