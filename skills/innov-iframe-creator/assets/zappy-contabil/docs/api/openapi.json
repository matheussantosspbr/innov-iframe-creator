                    "body": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "example": "0b9e6d4e-5a35-4d6e-9f35-6b1c1f3c9a10"
                          },
                          "name": {
                            "type": "string",
                            "example": "Escritório Exemplo"
                          },
                          "zappyUrl": {
                            "type": "string",
                            "example": "https://api-exemplo.zapcontabil.chat"
                          },
                          "active": {
                            "type": "boolean"
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "required": ["id", "name", "zappyUrl", "active", "createdAt", "updatedAt"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["body"],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Chave de operação ausente ou inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": ["message"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["error"],
                  "additionalProperties": false,
                  "description": "Chave de operação ausente ou inválida.",
                  "example": {
                    "error": {
                      "message": "Chave de operação ausente ou inválida."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tenants/{tenantId}": {
