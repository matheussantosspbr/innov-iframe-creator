              "schema": {
                "type": "object",
                "properties": {
                  "externalId": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Identificador da instalação devolvido pelo install.",
                    "example": "6f1c2a9e-1b2c-4d5e-8f90-123456789abc"
                  }
                },
                "required": [
                  "externalId"
                ]
              }
            }
          }
        },
        "security": [
          {
            "hmacSignature": [],
            "hmacTimestamp": []
          }
        ],
