    "/api/instances/{externalId}/diagnostics": {
      "get": {
        "summary": "Diagnóstico da instalação",
        "tags": [
          "diagnostics"
        ],
        "description": "Chamado pelo Backstage com JWT HS256 (escopo diagnostics:read, externalId igual ao da URL). Checa o banco e a API key do Chat Plataforma.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "6f1c2a9e-1b2c-4d5e-8f90-123456789abc"
            },
            "in": "path",
            "name": "externalId",
            "required": true,
            "description": "Identificador da instalação devolvido pelo install."
          }
        ],
        "security": [
          {
            "diagnosticsJwt": []
          }
        ],
        "responses": {
          "200": {
            "description": "Estado dos componentes (operational, degraded ou outage)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "body": {
                      "type": "object",
                      "properties": {
                        "externalId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Identificador da instalação devolvido pelo install.",
                          "example": "6f1c2a9e-1b2c-4d5e-8f90-123456789abc"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "operational",
                            "degraded",
                            "outage"
                          ]
                        },
                        "components": {
                          "readOnly": true,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string",
                                "example": "database"
                              },
                              "status": {
                                "type": "string",
                                "enum": [
                                  "operational",
                                  "degraded",
                                  "outage"
                                ]
                              },
                              "detail": {
                                "description": "Detalhe técnico da falha",
                                "type": "string"
                              }
                            },
                            "required": [
                              "name",
                              "status"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "checkedAt": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                          "description": "ISO 8601"
                        }
                      },
                      "required": [
                        "externalId",
                        "status",
                        "components",
                        "checkedAt"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "body"
                  ],
                  "additionalProperties": false,
                  "description": "Estado dos componentes (operational, degraded ou outage)"
                }
              }
            }
          },
          "401": {
            "description": "JWT ausente, expirado ou de outra instalação",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Mensagem em português para o administrador ou atendente"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false,
                  "description": "JWT ausente, expirado ou de outra instalação"
                }
              }
            }
          },
          "404": {
            "description": "Instalação não existe",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Mensagem em português para o administrador ou atendente"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false,
                  "description": "Instalação não existe"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Mensagem em português para o administrador ou atendente"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false,
                  "description": "Erro inesperado"
                }
              }
            }
          }
        }
      }
    },
    "/api/app/tickets/{ticketId}": {
      "get": {
        "summary": "Resumo do ticket aberto no atendimento",
        "tags": [
          "app"
        ],
        "description": "Rota do iframe: usa as credenciais da instalação identificada por x-account-id para consultar o ticket no Chat Plataforma.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,20}$",
              "example": "182736454928173645"
            },
            "in": "path",
            "name": "ticketId",
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "header",
            "name": "x-agent-id",
            "required": false,
            "description": "Id do atendente (contexto do iframe)"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "header",
            "name": "x-ticket-id",
            "required": false,
            "description": "Id do ticket (contexto do iframe)"
          }
        ],
        "security": [
          {
            "iframeAccountId": []
          }
        ],
        "responses": {
          "200": {
            "description": "Ticket",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "body": {
                      "readOnly": true,
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "protocol": {
                          "type": "number"
                        },
                        "status": {
                          "type": "number"
                        },
                        "priority": {
                          "type": "number"
                        },
                        "frozen": {
                          "type": "boolean"
                        },
                        "archived": {
                          "type": "boolean"
                        },
                        "contact": {
                          "nullable": true,
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            },
                            "phoneNumber": {
                              "nullable": true,
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "name",
                            "phoneNumber"
                          ],
                          "additionalProperties": false
                        },
                        "group": {
                          "nullable": true,
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "name"
                          ],
                          "additionalProperties": false
                        },
                        "agent": {
                          "nullable": true,
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
