{
  "openapi": "3.0.3",
  "info": {
    "title": "Chat Plataforma App",
    "version": "1.0.0",
    "description": "Respostas de sucesso vêm em { \"body\": ... } e erros em { \"error\": { \"message\": \"...\" } }."
  },
  "components": {
    "securitySchemes": {
      "hmacSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "x-signature",
        "description": "hex(HMAC-SHA256(clientSecret, \"<x-timestamp>:<corpo cru>\")). Usar junto com x-timestamp."
      },
      "hmacTimestamp": {
        "type": "apiKey",
        "in": "header",
        "name": "x-timestamp",
        "description": "Milissegundos desde a epoch (aceita ±5 min). Usar junto com x-signature."
      },
      "diagnosticsJwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "HS256 com o clientSecret; claims scope \"diagnostics:read\" e externalId igual ao da URL."
      },
      "iframeAccountId": {
        "type": "apiKey",
        "in": "header",
        "name": "x-account-id",
        "description": "accountId do iframe (= externalId da instalação)."
      }
    },
    "schemas": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "tags": [
          "health"
        ],
        "description": "Sem autenticação; não depende do banco nem do Chat Plataforma.",
        "responses": {
          "200": {
            "description": "Container de pé",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "body": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "example": "ok"
                        }
                      },
                      "required": [
                        "status"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "body"
                  ],
                  "additionalProperties": false,
                  "description": "Container de pé"
                }
              }
            }
          }
        }
      }
    },
    "/api/provision/install": {
      "post": {
        "summary": "Instala o app para uma organização",
        "tags": [
          "provision"
        ],
        "description": "Chamado pelo Backstage ao salvar as credenciais pela primeira vez. Valida a API key no Chat Plataforma, cria a instalação e devolve o externalId (201).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": {},
                "description": "Objeto plano de credenciais: a chave é o label do campo cadastrado no credentialsSchema do Backstage.",
                "example": {
                  "API Key do Chat Plataforma": "cp-chave-de-exemplo"
                }
              }
            }
          },
          "description": "Objeto plano de credenciais: a chave é o label do campo cadastrado no credentialsSchema do Backstage."
        },
        "security": [
          {
            "hmacSignature": [],
            "hmacTimestamp": []
          }
        ],
        "responses": {
          "201": {
            "description": "Instalação criada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "body": {
                      "type": "object",
                      "properties": {
                        "externalId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Identificador da instalação devolvido pelo install.",
                          "example": "6f1c2a9e-1b2c-4d5e-8f90-123456789abc"
                        }
                      },
                      "required": [
                        "externalId"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "body"
                  ],
                  "additionalProperties": false,
                  "description": "Instalação criada"
                }
              }
            }
          },
          "401": {
            "description": "Assinatura HMAC ausente, expirada (mais de 5 min) ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Mensagem em português para o administrador ou atendente"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false,
                  "description": "Assinatura HMAC ausente, expirada (mais de 5 min) ou inválida"
                }
              }
            }
          },
          "422": {
            "description": "Credencial inválida, API key recusada ou payload fora do contrato",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Mensagem em português para o administrador ou atendente"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false,
                  "description": "Credencial inválida, API key recusada ou payload fora do contrato"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Mensagem em português para o administrador ou atendente"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false,
                  "description": "Erro inesperado"
                }
              }
            }
          },
          "502": {
            "description": "Chat Plataforma indisponível na validação da API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Mensagem em português para o administrador ou atendente"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false,
                  "description": "Chat Plataforma indisponível na validação da API key"
                }
              }
            }
          }
        }
      }
    },
    "/api/provision/configure": {
      "post": {
        "summary": "Atualiza as credenciais de uma instalação",
        "tags": [
          "provision"
        ],
        "description": "Atualização parcial: aplica os campos recebidos sobre as credenciais salvas, valida o conjunto e testa a API key antes de gravar.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "externalId": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Identificador da instalação devolvido pelo install.",
                    "example": "6f1c2a9e-1b2c-4d5e-8f90-123456789abc"
                  },
                  "credentials": {
                    "type": "object",
                    "additionalProperties": {},
                    "description": "Só os campos enviados no save. Campo ausente ou com o placeholder de segredo = não mudou; null ou \"\" = apagado.",
                    "example": {
                      "API Key do Chat Plataforma": "cp-chave-de-exemplo"
                    }
                  }
                },
                "required": [
                  "externalId",
                  "credentials"
                ]
              }
            }
          }
        },
        "security": [
          {
            "hmacSignature": [],
            "hmacTimestamp": []
          }
        ],
        "responses": {
          "200": {
            "description": "Credenciais atualizadas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "body": {
                      "type": "object",
                      "properties": {
                        "externalId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Identificador da instalação devolvido pelo install.",
                          "example": "6f1c2a9e-1b2c-4d5e-8f90-123456789abc"
                        }
                      },
                      "required": [
                        "externalId"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "body"
                  ],
                  "additionalProperties": false,
                  "description": "Credenciais atualizadas"
                }
              }
            }
          },
          "401": {
            "description": "Assinatura HMAC ausente, expirada (mais de 5 min) ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Mensagem em português para o administrador ou atendente"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false,
                  "description": "Assinatura HMAC ausente, expirada (mais de 5 min) ou inválida"
                }
              }
            }
          },
          "404": {
            "description": "Instalação não existe",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Mensagem em português para o administrador ou atendente"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false,
                  "description": "Instalação não existe"
                }
              }
            }
          },
          "422": {
            "description": "Credencial inválida, API key recusada ou payload fora do contrato",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Mensagem em português para o administrador ou atendente"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false,
                  "description": "Credencial inválida, API key recusada ou payload fora do contrato"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Mensagem em português para o administrador ou atendente"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false,
                  "description": "Erro inesperado"
                }
              }
            }
          },
          "502": {
            "description": "Chat Plataforma indisponível na validação da API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Mensagem em português para o administrador ou atendente"
                        }
